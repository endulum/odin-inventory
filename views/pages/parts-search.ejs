<h1>Search Parts</h1>

<form action="/parts" method="get" class="parts-search">
  <label for="name"><b>Part name</b></label>
  <input type="text" name="name" id="name" value=<%= locals.query.name %>>
  
  <label for="category"><b>Category</b></label>
  <select name="category" id="category">
    <option value="">Any</option>
    <% locals.categories.forEach((category) => { %>
      <option value=<%= category.name %> <%= category.name === locals.query.category && 'selected' %>>
        <%= category.name %>
      </option>
    <% }) %>
  </select>
  
  

  <label for="sortBy"><b>Sort by</b></label>
  <select name="sortBy" id="sortBy">
    <% [
      { value: 'name ASC', label: 'Name (A - Z)' },
      { value: 'name DESC', label: 'Name (Z - A)' },
      { value: 'price DESC', label: 'Price (highest to lowest)' },
      { value: 'price ASC', label: 'Price (lowest to highest)' },
    ].forEach((sortOption) => { %>
      <option 
        value="<%= sortOption.value %>"
        <%= locals.query.sortBy === sortOption.value && 'selected' %>
      >
        <%= sortOption.label %>
      </option>
    <% }) %>
  </select>

  <div style="grid-column: 2 / 3; display: flex; flex-direction: row; justify-content: space-between;">
    <label for="isInStock" style="display: flex; align-items: center; gap: 0.5rem;">
      <input type="checkbox" name="isInStock" id="isInStock" <%= locals.query.isInStock === 'on' && 'checked' %>>
      <span>Is in stock</span>
    </label>

    <button type="submit"><b>Search</b></button>
  </div>
  
  
</form>

<%- include('../components/parts-list') %>