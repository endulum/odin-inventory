<h1>Browse Categories</h1>

<ul class="categories-list">
  <% locals.categories.forEach((category) => { %>
    <li class="categories-item">
      <h2>
        <a href="/categories/<%= category.id %>">
          <%= category.name %>
        </a>
      </h2>
      <p><%=  category.description %></p>
    </li>
  <% }) %>
</ul>