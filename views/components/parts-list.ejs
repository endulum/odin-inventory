<% if (locals.parts.length > 0) { %>
<ul class="parts-list">
  <% locals.parts.forEach((part) => { %>
    <li class="parts-item">
      <div>
        <h2><%= part.name %></h2>
        <small><%= part.category %></small>
      </div>
      <div style="display: flex; flex-direction: row; justify-content: space-between;">
        <p><%= part.in_stock %> in stock</p>
        <p><b>$<%= part.price %></b></p>
      </div>
    </li>
  <% }) %>
</ul>
<% } else { %>
<p>No items found.</p>
<% } %>
